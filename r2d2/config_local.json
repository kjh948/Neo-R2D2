{
  "serial_port": "/dev/ttyAMA0",
  "baudrate": 115200,
  "serial_read_timeout": 1.0,

  "ws_host": "0.0.0.0",
  "ws_port": 8887,
  "ws_path": "/",

  "stream_host": "0.0.0.0",
  "stream_port": 12121,
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8080,
  "camera_index": 0,
  "camera_width": 640,
  "camera_height": 480,
  "camera_jpeg_quality": 70,

  "discovery_enabled": true,
  "discovery_port": 8090,

  "face_detection_enabled": false,
  "voice_recognition_enabled": true,
  "voice_language": "en-ko",
  "vosk_english_model_path": "r2d2/model/vosk-model-small-en-us-0.15",
  "vosk_korean_model_path": "r2d2/model/vosk-model-small-ko-0.22",
  "audio_device": "default",
  "mute": false,
  "allow_unpaired_clients": true,
  "allow_host_shutdown": false,

  "sound_dir": "sound_effects",
  "cascade_dir": "sound_effects",
  "state_file": "state.json",

  "log_level": "info",

  "install_command": ["bash", "/opt/r2d2/update.sh", "{artifact}"]
}
