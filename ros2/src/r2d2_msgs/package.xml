<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2d2_msgs</name>
  <version>0.1.0</version>
  <description>ROS 2 interfaces for the Neo-R2D2 MCU bridge and sound node
  (gin status, panel buttons, sound playback requests/events, and the
  per-function command services mirroring r2d2/commander.py).</description>
  <maintainer email="kjh948@example.com">kjh948</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
