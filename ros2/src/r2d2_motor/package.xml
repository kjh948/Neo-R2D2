<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2d2_motor</name>
  <version>0.1.0</version>
  <description>ROS 2 node that drives the R2-D2 MCU: geometry_msgs/Twist ->
  move frames, plus the function bridge (head/mode/projector/arm/lightsaber/
  led/lcd/sound services, status/button topics under /r2d2/).</description>
  <maintainer email="kjh948@example.com">kjh948</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>r2d2_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
