<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2d2_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch for Neo-R2D2: motor node, COIN lidar, rf2o odometry + slam_toolbox.</description>
  <maintainer email="kjh948@example.com">kjh948</maintainer>
  <license>MIT</license>

  <exec_depend>r2d2_motor</exec_depend>
  <exec_depend>coin_d4_driver</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ros2_mpu6050</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
