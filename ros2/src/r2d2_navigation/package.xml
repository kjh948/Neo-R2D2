<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2d2_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 navigation stack bringup for Neo-R2D2 (holonomic, rotation-incapable, odom-free).</description>
  <maintainer email="kjh948@example.com">kjh948</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>r2d2_motor</exec_depend>
  <exec_depend>r2d2_bringup</exec_depend>
  <exec_depend>ldlidar_ros2</exec_depend>
  <exec_depend>hector_mapping</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
